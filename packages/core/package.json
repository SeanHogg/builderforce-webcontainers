{
  "name": "@seanhogg/builderforce-webcontainers-core",
  "version": "2026.11.1",
  "description": "BuilderForce WebContainers — core. A runtime-agnostic in-browser dev server: virtual file system, module resolution, import rewriting to a package CDN, CSS/JSON/asset modules and project detection. No COOP/COEP required.",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./check": {
      "types": "./dist/check/index.d.ts",
      "import": "./dist/check/index.js"
    },
    "./app": {
      "types": "./dist/app/index.d.ts",
      "import": "./dist/app/index.js"
    }
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node ./node_modules/typescript-7/bin/tsc -p tsconfig.build.json",
    "typecheck": "node ./node_modules/typescript-7/bin/tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "webcontainer",
    "in-browser",
    "dev-server",
    "esbuild",
    "vite",
    "sandbox",
    "preview",
    "builderforce"
  ],
  "author": {
    "name": "Sean Hogg",
    "email": "seanhogg@gmail.com",
    "url": "https://builderforce.ai"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/SeanHogg/builderforce-webcontainers.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/SeanHogg/builderforce-webcontainers/issues"
  },
  "homepage": "https://github.com/SeanHogg/builderforce-webcontainers/tree/main/packages/core#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "dependencies": {
    "es-module-lexer": "^1.5.4",
    "fflate": "^0.8.2"
  },
  "peerDependencies": {
    "typescript": ">=5.0.0 <7"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "devDependencies": {
    "@angular/common": "20.3.35",
    "@angular/compiler": "20.3.35",
    "@angular/core": "20.3.35",
    "@angular/platform-browser": "20.3.35",
    "@types/jsdom": "21.1.7",
    "@types/node": "^20",
    "jsdom": "26.1.0",
    "rxjs": "7.8.2",
    "tslib": "2.8.1",
    "zone.js": "0.15.1",
    "@vue/compiler-sfc": "^3.5.0",
    "esbuild": "^0.24.0",
    "less": "^4.2.0",
    "@types/less": "^3.0.6",
    "sass": "^1.80.0",
    "svelte": "^5.0.0",
    "typescript": "5.9.3",
    "typescript-7": "npm:typescript@^7.0.2",
    "vitest": "^2.1.0"
  }
}
