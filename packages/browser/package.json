{
  "name": "@seanhogg/builderforce-webcontainers",
  "version": "2026.10.5",
  "description": "BuilderForce WebContainers — browser runtime. Boots an in-browser dev server for a project held in memory and serves it to an iframe through a service worker. Open source, no COOP/COEP, no session caps.",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./check": {
      "types": "./dist/check/index.d.ts",
      "import": "./dist/check/index.js"
    },
    "./check/worker.js": "./dist/check/worker.js",
    "./node/worker.js": "./dist/node/worker.js",
    "./assets": {
      "types": "./dist/assets.d.ts",
      "import": "./dist/assets.js"
    },
    "./sw.js": "./dist/sw.js",
    "./relay.html": "./dist/relay.html",
    "./process-worker.js": "./dist/process-worker.js"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/build-sw.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "webcontainer",
    "service-worker",
    "in-browser",
    "dev-server",
    "preview",
    "esbuild-wasm",
    "builderforce"
  ],
  "author": {
    "name": "Sean Hogg",
    "email": "seanhogg@gmail.com",
    "url": "https://builderforce.ai"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/SeanHogg/builderforce-webcontainers.git",
    "directory": "packages/browser"
  },
  "bugs": {
    "url": "https://github.com/SeanHogg/builderforce-webcontainers/issues"
  },
  "homepage": "https://github.com/SeanHogg/builderforce-webcontainers/tree/main/packages/browser#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "dependencies": {
    "@seanhogg/builderforce-webcontainers-core": "workspace:^",
    "esbuild-wasm": "^0.24.0"
  },
  "devDependencies": {
    "@vue/compiler-sfc": "^3.5.0",
    "esbuild": "^0.24.0",
    "svelte": "^5.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.1.0"
  }
}
