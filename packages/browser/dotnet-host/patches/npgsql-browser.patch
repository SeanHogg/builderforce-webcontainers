--- /dev/null
+++ b/src/Npgsql/NpgsqlStreamTransport.cs
@@ -0,0 +1,17 @@
+using System;
+using System.IO;
+using System.Threading;
+using System.Threading.Tasks;
+
+namespace Npgsql;
+
+/// <summary>
+/// A host-provided transport: when <see cref="Connect"/> is set, every physical connection is the stream it returns
+/// for the connection's host and port, instead of a socket. For runtimes without sockets (browser-wasm), where the
+/// host bridges the stream to its own network.
+/// </summary>
+public static class NpgsqlStreamTransport
+{
+    /// <summary>Opens the stream for a host and port; null (the default) uses sockets.</summary>
+    public static Func<string, int, CancellationToken, ValueTask<Stream>>? Connect { get; set; }
+}
